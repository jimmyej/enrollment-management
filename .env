# .env.example for enrollment-management
# Copy to .env and fill values, or set as environment variables.

# MongoDB connection (URI form). Default in application.properties uses localhost.
MONGODB_URI=mongodb://localhost:27017/management-enrollment-db
MONGODB_DATABASE=management-enrollment-db

# Cloudinary credentials (used by MediaConfig)
# Set these in your environment or CI secrets (names used in GitHub Actions: CLOUD_NAME, API_KEY, API_SECRET)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Spring / app options (optional)
#SPRING_PROFILES_ACTIVE=local
#SERVER_PORT=8080

# Notes:
# - Rename this file to ".env" for local development and use a dotenv loader (IDE plugin or tooling),
#   or export the variables in your shell (e.g., PowerShell: $env:CLOUD_NAME="..." ).
# - In CI, add CLOUD_NAME/API_KEY/API_SECRET as repository secrets and they will be injected into the workflow.
# - If you prefer Spring-style names, Spring will pick up environment variables automatically when
#   mapped (e.g., spring.data.mongodb.uri can be set via environment variable SPRING_DATA_MONGODB_URI).
